    "widget_57": {
      "uri": "widgets/common/text/",
      "version": "1.17.0",
      "label": "Background Information",
      "config": {
        "text": "<p><strong>Toronto-Hamilton MedBridge</strong> is<span style=\"font-size: inherit;\"> an application outlining the accessibility of sustainable transportation in Toronto and Hamiltonwhen attempting to acess healthcare services, including hospitals and clinics. </span></p><p><br></p><p><span style=\"font-size: inherit;\">We completed a complex analysis involving the construction of a multimodal transportation network by integrating the OpenStreetMap road network with the latest scheduled transit services from the Toronto Transit Commission and Hamilton Street Railway. </span></p><p><br></p><p><span style=\"font-size: inherit;\">The app includes isochrone polygons for each hospital and clinic to delineate areas reachable within specified travel-time thresholds under four modal scenario assumptions varying transportation method and service period.</span></p><p><br></p><p><span style=\"font-size: inherit;\">The results of out analysis reinforce the pre-existing notion of an urban-rural divide in the existence of healthcare facilities, and the transit options that may be needed by some individuals to access them. </span></p><p><br></p><p><span style=\"font-size: inherit;\">You can learn more about </span><strong style=\"font-size: inherit;\">Toronto-Hamilton MedBridge </strong><span style=\"font-size: inherit;\">project with this short youtube video: </span><a href=\"https://youtu.be/BRHDfFl6kGA?si=ELVnWxVhX7nFrJed\" target=\"_self\" data-uniqueid=\"38ecc0c7_802e_fb7d_98df_0937d02f3b83\" data-dsid=\"\" data-link=\"%7B%22linkType%22%3A%22WEB_ADDRESS%22%2C%22openType%22%3A%22_self%22%2C%22value%22%3A%22https%3A%2F%2Fyoutu.be%2FBRHDfFl6kGA%3Fsi%3DELVnWxVhX7nFrJed%22%2C%22expression%22%3Anull%7D\" style=\"font-size: inherit;\">Youtube Video</a></p>",
        "placeholder": "Double click to edit text",
        "style": {
          "wrap": true
        },
        "tooltip": {
          "name": "Click here for background information!",
          "parts": [
            {
              "type": "STRING",
              "exp": "\"Click here for background information!\""
            }
          ]
        }
      },
      "id": "widget_57"
    }
